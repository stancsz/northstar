# Disposable project artifacts
/tmp/

# Python / test caches
.pytest_cache/
__pycache__/
*.py[cod]

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# A2A generated evidence is archived outside this repository
/docs/evals/a2a-stack/*
!/docs/evals/a2a-stack/README.md

# A2A test scratch trees are disposable and must not be tracked
/a2a-stack/scratchtmp/

# Local Wrangler cache only; keep other project configuration visible
/.wrangler/cache/

# Evaluation scratch runs (keep eval/tasks/ and eval/results/ tracked)
/eval/runs/

# LaTeX build artifacts (keep paper/*.tex and paper/*.bib tracked)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.blg
paper/*.bbl
paper/*.pdf
