{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stancsz/spot-advisor/blob/main/eval/telemetry_schema.json",
  "title": "Spot Advisor Evaluation Telemetry Record",
  "description": "Per-task and per-consultation telemetry schema for reproducible Phase 2 evaluation and arXiv tables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp_utc",
    "git_commit",
    "benchmark",
    "task_id",
    "arm",
    "executor_model",
    "seed",
    "resolved",
    "wall_clock_seconds",
    "executor_turns",
    "advisor_rounds",
    "executor_tokens",
    "advisor_tokens",
    "estimated_cost_usd",
    "consultations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "enum": [
        "A1_small_solo",
        "A2_small_bon",
        "A3_frontier_solo",
        "A4_full_transcript_advisor",
        "T1_spot_advisor",
        "ablation_no_linter",
        "ablation_prose_only",
        "ablation_self_trigger",
        "ablation_unstructured_output",
        "sweep_effort_budget"
      ]
    },
    "ablation_flags": {
      "type": "object",
      "additionalProperties": true
    },
    "executor_model": {
      "type": "string",
      "minLength": 1
    },
    "advisor_model": {
      "type": ["string", "null"]
    },
    "advisor_transport": {
      "type": ["string", "null"],
      "enum": ["codex", "gateway", "claude", "anthropic_native", null]
    },
    "reasoning_effort": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", "max", null]
    },
    "seed": {
      "type": "integer"
    },
    "resolved": {
      "type": "boolean"
    },
    "wall_clock_seconds": {
      "type": "number",
      "minimum": 0
    },
    "executor_turns": {
      "type": "integer",
      "minimum": 0
    },
    "advisor_rounds": {
      "type": "integer",
      "minimum": 0
    },
    "executor_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cached"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cached": { "type": "integer", "minimum": 0 }
      }
    },
    "advisor_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "visible_output", "reasoning", "total_output", "cached"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "visible_output": { "type": "integer", "minimum": 0 },
        "reasoning": { "type": "integer", "minimum": 0 },
        "total_output": { "type": "integer", "minimum": 0 },
        "cached": { "type": "integer", "minimum": 0 }
      }
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "failure_category": {
      "type": ["string", "null"],
      "enum": ["E1", "E2", "E3", "E4", "E5", null]
    },
    "consultations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round",
          "trigger_reason",
          "packet_chars",
          "evidence_attached",
          "input_tokens",
          "visible_output_tokens",
          "reasoning_tokens",
          "total_output_tokens",
          "advice_words",
          "schema_ok",
          "visible_budget_ok",
          "truncated",
          "elapsed_seconds"
        ],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "trigger_reason": { "type": "string", "minLength": 1 },
          "packet_chars": { "type": "integer", "minimum": 0 },
          "evidence_attached": {
            "type": "array",
            "items": { "type": "string" }
          },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "visible_output_tokens": { "type": "integer", "minimum": 0 },
          "reasoning_tokens": { "type": "integer", "minimum": 0 },
          "total_output_tokens": { "type": "integer", "minimum": 0 },
          "advice_words": { "type": "integer", "minimum": 0 },
          "schema_ok": { "type": "boolean" },
          "visible_budget_ok": { "type": "boolean" },
          "truncated": { "type": "boolean" },
          "elapsed_seconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
