{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spot Advisor paired evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "suite",
    "stage",
    "arm",
    "seed",
    "git_commit",
    "source_sha256",
    "timestamp_utc",
    "subscription",
    "executor_model",
    "executor_effort",
    "executor_transport",
    "executor_usage",
    "executor_attempts",
    "advisor_model",
    "quota_before",
    "quota_after",
    "turn",
    "reroutes",
    "wall_seconds",
    "agent_seconds",
    "accepted",
    "verdict",
    "consultations",
    "checkpoints",
    "tool_events",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "enum": [
        "swe-bench-pro-v2",
        "diagnostic",
        "chromium"
      ]
    },
    "stage": {
      "enum": [
        "pilot",
        "formal"
      ]
    },
    "arm": {
      "enum": [
        "spot_advisor",
        "astra_only"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "minLength": 1
    },
    "subscription": {
      "type": "object",
      "properties": {
        "type": {
          "const": "chatgpt"
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "plan"
      ],
      "additionalProperties": false
    },
    "executor_model": {
      "enum": [
        "gpt-6-luna",
        "gpt-6.2-astra"
      ]
    },
    "executor_effort": {
      "enum": [
        "max",
        "medium"
      ]
    },
    "executor_transport": {
      "const": "codex_subscription_responses"
    },
    "executor_usage": {
      "$ref": "#/$defs/usage"
    },
    "executor_attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "advisor_model": {
      "enum": [
        "gpt-6.2-astra",
        null
      ]
    },
    "quota_before": {
      "type": [
        "object",
        "null"
      ]
    },
    "quota_after": {
      "type": [
        "object",
        "null"
      ]
    },
    "turn": {
      "type": "object"
    },
    "reroutes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "agent_seconds": {
      "type": "number",
      "minimum": 0
    },
    "accepted": {
      "type": "boolean"
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "consultations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consultation"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tool_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "consultation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "attempt_id",
        "requested_model",
        "reasoning_effort"
      ],
      "additionalProperties": true
    },
    "consultation": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "trigger": {
          "enum": [
            "two_failed_checks",
            "conflicting_evidence"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "packet_chars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "advice_applied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "next_check_passed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "trigger",
        "revision",
        "attempts",
        "status",
        "packet_chars",
        "elapsed_seconds",
        "advice_applied",
        "next_check_passed"
      ]
    }
  }
}
